{
  "name": "botforge-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "BotForge Studio - Telegram bot management and visual automation platform",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "start": "node backend/src/server.js",
    "dev": "node --watch backend/src/server.js",
    "test": "node --test \"tests/unit/**/*.test.js\" \"tests/integration/**/*.test.js\"",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:integration": "node --test \"tests/integration/**/*.test.js\"",
    "test:e2e": "node --test \"tests/e2e/**/*.test.js\"",
    "test:all": "node --test \"tests/unit/**/*.test.js\" \"tests/integration/**/*.test.js\" \"tests/e2e/**/*.test.js\"",
    "poll": "node backend/scripts/poll-dev.js",
    "webhook:register": "node backend/scripts/register-webhook.js",
    "check:firebase": "node backend/scripts/check-firebase.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "firebase-admin": "^12.7.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "jsdom": "^30.1.3",
    "supertest": "^7.0.0"
  }
}
