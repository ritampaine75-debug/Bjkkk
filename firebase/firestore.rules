rules_version = '2';

// BotForge Studio stores everything in server-only collections and is reached
// exclusively through the Express API (Firebase Admin SDK). The browser never
// talks to Firestore directly, so all client access is denied. This is the
// safest possible default: even a leaked client config cannot read bot tokens.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
