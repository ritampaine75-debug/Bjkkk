# ---------------------------------------------------------------------------
# BotForge Studio - server environment template
# Copy to .env (never commit the real file) and fill in real values.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=8080
APP_BASE_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# Database
# DB_MODE=firestore uses Firebase Admin SDK (recommended for production).
# DB_MODE=json is a local development store (NOT for production).
# ---------------------------------------------------------------------------
DB_MODE=json
JSON_DB_PATH=backend/.data/db.json

# ---------------------------------------------------------------------------
# Firebase Admin (server only). Never ship these values to the browser.
# Paste the private key with literal \n escapes and keep it quoted.
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=hiiii-72d78
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase *client* config is public by design and is served to the browser by
# GET /api/v1/auth/config when AUTH_MODE=firebase. None of these values is a
# secret: they identify the project, they do not authorise anything.
# The keys below belong to the project hiiii-72d78 (see docs/FIREBASE-SETUP.md).
FIREBASE_API_KEY=AIzaSyCChxWVg-w1TiertkXlUrfUgcC19y-CPNw
FIREBASE_AUTH_DOMAIN=hiiii-72d78.firebaseapp.com
FIREBASE_DATABASE_URL=https://hiiii-72d78-default-rtdb.firebaseio.com
FIREBASE_STORAGE_BUCKET=hiiii-72d78.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=560685164053
FIREBASE_APP_ID=1:560685164053:web:7f672f7503160ec868901c

# ---------------------------------------------------------------------------
# Authentication
# AUTH_MODE=firebase -> Firebase Authentication ID tokens (production)
# AUTH_MODE=local    -> development-only email/password sessions (refused when
#                      NODE_ENV=production)
# ---------------------------------------------------------------------------
AUTH_MODE=local
LOCAL_AUTH_SECRET=replace-with-a-long-random-string-at-least-32-chars
LOCAL_AUTH_SESSION_TTL_SECONDS=604800

# ---------------------------------------------------------------------------
# Token vault (AES-256-GCM). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Back this key up securely: losing it makes stored bot tokens unrecoverable.
# Multiple keys may exist for rotation; *_CURRENT selects the write key.
# ---------------------------------------------------------------------------
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_VERSION=1
# TOKEN_ENCRYPTION_KEY_V2=

# ---------------------------------------------------------------------------
# Telegram
# TELEGRAM_WEBHOOK_SECRET is the fallback secret used when a bot-level secret
# has not been generated yet; per-bot secrets are preferred.
# ---------------------------------------------------------------------------
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_WEBHOOK_BASE_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_API_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Security
# Comma separated list of allowed browser origins. Empty = same-origin only.
# ---------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:8080
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
CONNECT_RATE_LIMIT_MAX_REQUESTS=10
MAX_JSON_BODY_BYTES=262144

# ---------------------------------------------------------------------------
# Execution runtime
# ---------------------------------------------------------------------------
EXECUTION_TIMEOUT_MS=15000
EXECUTION_MAX_STEPS=60
EXECUTION_MAX_DEPTH=24
QUEUE_CONCURRENCY=4
EXECUTION_RETENTION_DAYS=30
SCHEDULER_ENABLED=false
SCHEDULER_TICK_SECONDS=30

# ---------------------------------------------------------------------------
# HTTP action allowlist
# Workflow "Call HTTP API" nodes are disabled unless a host allowlist is set.
# Only HTTPS hosts listed here may be called (never internal/private ranges).
# ---------------------------------------------------------------------------
HTTP_ACTION_ALLOWED_HOSTS=
ALLOW_HTTP_ACTIONS=false

# ---------------------------------------------------------------------------
# Logging / proxy
# ---------------------------------------------------------------------------
LOG_LEVEL=info
# Set to the number of trusted proxy hops when running behind a load balancer so
# rate limiting sees the real client IP.
TRUST_PROXY=0
